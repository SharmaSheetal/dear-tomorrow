# Copy this file to .env and fill in real values. .env is gitignored.

# Which provider get_model() should instantiate: groq | gemini | anthropic
MODEL_PROVIDER=groq

# Only the key for your chosen MODEL_PROVIDER needs to be set.
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional override -- defaults to groq/openai/gpt-oss-120b (verified working via smoke test).
# GROQ_MODEL_ID=groq/openai/gpt-oss-120b